# Path to the Chi session corpus. Never committed — see .gitignore.
# Only needed by the offline tools (tools/ingest.ts, tools/roundtrip.ts) and their tests;
# the app itself reads from Underlay.
CHI_CORPUS_DIR=./chi-eval-corpus

# Underlay instance. Local dev is http://localhost:4100.
UNDERLAY_URL=https://dev.underlay.org

# Write-scoped Underlay API key (dev.underlay.org → Settings → API keys).
# The key's user must be a MEMBER of the org passed as --owner: collection creation
# checks org membership, not just the key's scope.
UNDERLAY_API_KEY=

# Shared gate password. Unset means nobody can enter — the gate fails closed.
DEMO_PASSWORD=

# Signs the gate and persona cookies. Any long random string.
SESSION_SECRET=
